{
  "name": "app",
  "private": true,
  "version": "0.2.0",
  "description": "VLM-based local image search",
  "author": "opoeci6",
  "repository": {
    "type": "git",
    "url": "https://github.com/opoeci6/VBLIS-vlm-based-local-image-search.git"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "url": "^0.11.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.27",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.vblis.search",
    "productName": "VBLIS",
    "publish": {
      "provider": "github",
      "owner": "opoeci6",
      "repo": "VBLIS-vlm-based-local-image-search"
    },
    "directories": {
      "output": "dist-built"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "extraResources": [
      {
        "from": "../api/dist/api",
        "to": "api"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "7z"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "installer/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
